{
  "_comment": "All tunables live here. Secrets live in .env only. Thresholds are SPEC v0.2 priors and stay FROZEN inside a tuning window.",
  "birdeye": {
    "plan": "starter",
    "base_url": "https://public-api.birdeye.so",
    "rate_safety": 0.8,
    "_daily_cu_cap_comment": "null = derived from plan (monthly/30 * 0.9 = 240k/day on Starter). Was 3000 during free-tier dev.",
    "daily_cu_cap": null
  },
  "db": {
    "path": "data/scanner.sqlite"
  },
  "recorder": {
    "enabled": true,
    "dir": "raw"
  },
  "logging": {
    "dir": "logs",
    "level": "INFO"
  },
  "discord": {
    "use_test_channel": true
  },
  "chains": {
    "solana": {
      "enabled": true,
      "birdeye_chain": "solana",
      "scan_interval_s": 60,
      "stage0": {
        "_comment": "filters are Birdeye token_list_v3 params passed verbatim; re-verified client-side",
        "filters": {
          "min_liquidity": 8000,
          "min_market_cap": 20000,
          "min_holder": 30,
          "min_volume_5m_usd": 1500
        },
        "alive_within_s": 90,
        "page_limit": 100,
        "sort_keys": [
          "volume_5m_change_percent",
          "volume_1m_usd"
        ]
      },
      "stage1": {
        "_comment": "short mode. CALIBRATED ONCE 2026-09-08 on 0.32h of stored rows (SPEC s14): rvol_1m is a RECENCY check (>=1.5), rvol_5m is the ignition gate; page-percentile gates disabled (page mixes mcap tiers). FROZEN.",
        "min_age_s": 180,
        "rvol_1m_min": 1.5,
        "rvol_5m_min": 3.0,
        "trade_1m_count_min": 8,
        "trade_5m_count_min": 25,
        "price_change_1m_min_pct": -8.0,
        "price_change_5m_min_pct": 4.0,
        "price_change_5m_max_pct": 60.0,
        "price_change_1h_max_pct": 150.0,
        "wash_turnover_5m_min": 2.0,
        "wash_abs_price_change_5m_max_pct": 3.0,
        "impact_eff_min_percentile": 40,
        "percentile_gates": {},
        "holder_growth_5m_min_pct": 3.0,
        "cohort_z_min_n": 12,
        "renominate_after_s": 1200
      }
    },
    "robinhood": {
      "enabled": true,
      "birdeye_chain": "robinhood",
      "scan_interval_s": 120,
      "stage0": {
        "_comment": "Robinhood list v3 has no 1m/5m/30m fields and holder is always null (T2) - filter/sort on 1h windows, no holder filter",
        "filters": {
          "min_liquidity": 4000,
          "min_market_cap": 20000,
          "min_volume_1h_usd": 2000
        },
        "alive_within_s": 180,
        "page_limit": 100,
        "sort_keys": [
          "volume_1h_change_percent",
          "volume_1h_usd"
        ]
      },
      "stage1": {
        "_comment": "hourly mode. CALIBRATED ONCE 2026-09-08 (SPEC s14): igniters ENTER the page so most have no previous poll; fallback tightened. Coarse pre-filter only - real RH ignition comes from the trade tape (T5/T6). FROZEN.",
        "min_age_s": 180,
        "prev_dt_range_s": [
          60,
          300
        ],
        "rvol_dt_min": 4.0,
        "d_trades_min": 8,
        "fallback_vol_1h_chg_min_pct": 2000.0,
        "fallback_trade_1h_count_min": 50,
        "price_change_1h_min_pct": 10.0,
        "price_change_1h_max_pct": 150.0,
        "wash_turnover_1h_min": 2.0,
        "wash_abs_price_change_1h_max_pct": 3.0,
        "percentile_gates": {},
        "cohort_z_min_n": 12,
        "renominate_after_s": 1200,
        "vol_1h_min_usd": 5000.0,
        "fallback_price_change_1h_max_pct": 80.0
      }
    }
  },
  "candidates": {
    "max_per_chain": 12,
    "deep_poll_interval_s": 25,
    "stay_rvol_5m_min": 2.0,
    "stay_ofi_5m_min": 0.0,
    "max_stay_min": 8
  },
  "alerts": {
    "cooldown_min": 20,
    "max_per_hour_per_chain": 6,
    "tier_ignition_score": 55,
    "tier_confirmed_score": 75,
    "eligible_after_anchor_s": [
      30,
      90
    ]
  },
  "labeler": {
    "_comment": "close pass: scan_rows (free) -> multi_price (Lite+). path pass: one OHLCV 1m call at the final horizon per NOMINATION (45 CU) fills MFE/MAE for all horizons. Controls get close-based labels only.",
    "horizons_min": [
      5,
      15,
      30,
      60
    ],
    "control_sample_per_cycle": 0.5,
    "tick_interval_s": 30,
    "scan_row_match_window_s": 90,
    "grace_s": 600,
    "ohlcv_path_for": "nominations",
    "max_path_attempts": 3,
    "path_deadline_s": 21600
  },
  "tape": {
    "_comment": "Stage-2 trade tape (txs v3, 12 CU/page of 100). Polls the active candidate set; T8 owns the real set, until then the runner uses WATCH nominations from the last candidates.max_stay_min. Budgeted: the tape is the most expensive stream.",
    "poll_interval_s": 60,
    "pages_on_first_fetch": 2,
    "refresh_every_n_polls": 3,
    "ring_size": 600,
    "daily_cu_budget": 80000
  }
}
